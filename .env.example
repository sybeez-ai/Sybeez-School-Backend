# Core API
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

DATABASE_URL=postgresql+asyncpg://sybeez:sybeez@localhost:5432/sybeez_school
DATABASE_URL_SYNC=postgresql://sybeez:sybeez@localhost:5432/sybeez_school
# Production API and worker: DB_IAM_AUTH=true (sybeez_app, rds_iam). SSL is required.
# Host, port, user, and database default to DATABASE_URL. Override with the vars below.
# The migrate task leaves DB_IAM_AUTH unset and uses the master password in DATABASE_URL.
# DB_IAM_AUTH=true
# DATABASE_HOST=
# DATABASE_PORT=5432
# DATABASE_USER=sybeez_app
# DATABASE_NAME=sybeez_school
# AWS_REGION=ap-south-1
# DATABASE_SSL_MODE=require
# redis:// for local, rediss:// for TLS (ElastiCache / MemoryDB).
REDIS_URL=redis://localhost:6379/0
# Job queue. redis is the default. Set sqs and SQS_QUEUE_URL to use Amazon SQS.
JOBS_BACKEND=redis
SQS_QUEUE_URL=

JWT_SECRET=change-me-in-production-use-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=14

# AWS Cognito — Sybeez_School_Platform (us-east-1)
AUTH_MODE=both
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_52gWoFAcK
COGNITO_APP_CLIENT_ID=61m9q3bfh3vpi4uesopfcr1joi
COGNITO_APP_CLIENT_SECRET=
# Cognito Hosted UI domain, e.g. "https://example.auth.us-east-1.amazoncognito.com"
COGNITO_DOMAIN=
# Where Cognito redirects back (must be allowlisted on app client)
COGNITO_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/cognito/callback
# Frontend base URL for final redirect after OAuth completes
WEB_APP_URL=http://localhost:3000

# AI Teacher service connection (must match AI Service CORE_* values)
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_TOKEN=dev-internal-service-token
CORE_INTERNAL_TOKEN=dev-internal-service-token
AI_EMBEDDING_DIM=1536

# Worker
WORKER_CONCURRENCY=2

# Payments (Razorpay)
# Set these and use provider=razorpay on Fee Settings per school.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Payroll payslip storage. Production requires S3_BUCKET (object key only; no bucket is created by the app).
# Leave the bucket empty in development to store files under apps/api/media.
S3_BUCKET=
S3_REGION=ap-south-1
S3_PUBLIC_BASE_URL=
PAYROLL_RATE_LIMIT_PER_MINUTE=120
